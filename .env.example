# ═════════════════════════════════════════════════════════════════════════════
# Шаблон конфигурации (.env)
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# ═════════════════════════════════════════════════════════════════════════════

# ─── 1. Telegram-бот (обязательно) ───────────────────────────────────────────
# Получите токен у @BotFather
BOT_TOKEN=1234567890:AAF_your_telegram_bot_token_here

# Username вашего бота (без @) — подставляется в кнопки лендинга и оферту
BOT_USERNAME=your_study_bot

# Telegram ID главного администратора (узнать можно у @userinfobot)
ADMIN_TG_ID=123456789

# Telegram ID редактора (необязательно; можно менять прямо из бота или админки)
EDITOR_TG_ID=

# Дополнительные Telegram ID админов для веб-панели (через запятую, если их несколько)
ADMIN_TG_IDS=123456789

# ─── 2. Бренд и реквизиты исполнителя (подставляются на сайт и в документы) ──
BRAND_NAME=StudyFlow
PUBLIC_URL=https://example.com
SUPPORT_EMAIL=support@example.com
OWNER_NAME=Иванов Иван Иванович
OWNER_INN=000000000000
OWNER_CITY=Москва

# Текст диагонального водяного знака на PDF-превью до оплаты
WATERMARK_TEXT=ОПЛАТИТЕ ДЛЯ ПОЛУЧЕНИЯ

# ─── 3. Оплата — Робокасса + чеки 54-ФЗ (НПД / ИП) ──────────────────────────
# Если оставить ROBOKASSA_LOGIN пустым — бот работает без автооплаты
# (ссылки можно выставлять вручную или тестировать воронку превью).
ROBOKASSA_LOGIN=
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH_ALGO=sha256

# Тестовые пароли (из раздела «Технические настройки» Робокассы)
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=

# Боевые пароли (для ROBOKASSA_IS_TEST=false)
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=

# Fallback email для чеков 54-ФЗ (по умолчанию равен SUPPORT_EMAIL)
ROBOKASSA_FALLBACK_EMAIL=support@example.com

# Внешний HTTPS-хост для приёма Result URL вебхуков Робокассы (/robokassa/result)
WEBHOOK_HOST=https://example.com
PAYMENT_WEBHOOK_PORT=8080

# ─── 4. Веб-панель (/admin, /editor, /pay и лендинг /) ──────────────────────
ADMIN_WEB_PORT=8081
SESSION_TTL_HOURS=24

# Секреты для подписи сессий и CSRF-токенов (сгенерируйте: openssl rand -base64 32)
# Если оставить пустыми — сгенерируются автоматически при запуске
SESSION_SECRET=
CSRF_SECRET=
